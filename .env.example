NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_API_KEY=your-google-genai-key
GOOGLE_MODEL=gemini-2.5-flash-lite
# Owners: comma-separated emails with full access, who add and remove curators at /admin/curators.
# Other curators are managed in the app (curators table), not here. CURATOR_EMAILS is the old name and still works.
OWNER_EMAILS=owner@example.com
# Public address of the site, used in invite links. Optional locally; set it in production.
SITE_URL=http://localhost:3000
